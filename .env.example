# Example environment configuration for BE106 Backend Project
# Copy this file to `.env` and fill in real values locally.

# Secret key used for signing JWTs and other security-related features.
# In development, you can use any random string. In production, use a strong, unique secret.
JWT_SECRET=change-me-in-local-env

# Database connection string.
# For local development, you can:
# - leave this blank to use the default SQLite file dev.db, or
# - point to a different database URL.
DATABASE_URL=